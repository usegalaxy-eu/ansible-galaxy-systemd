[Unit]
Description=Galaxy SSE Monitor
After=network.target
After=time-sync.target

[Service]
UMask=022
Type=simple
User={{ galaxy_user.name }}
Group={{ __galaxy_user_group }}
WorkingDirectory={{ galaxy_server_dir }}
TimeoutStartSec=10
ExecStart={{ galaxy_venv_dir }}/bin/python {{ galaxy_server_dir }}/lib/galaxy/sse_monitor/__main__.py
Environment=PYTHONPATH=server/lib GALAXY_CONFIG_FILE={{ galaxy_config_file }}
MemoryMax={{ galaxy_systemd_memory_limit_sse_monitor }}G
Restart=always

MemoryAccounting=yes
CPUAccounting=yes
BlockIOAccounting=yes

[Install]
WantedBy=multi-user.target
